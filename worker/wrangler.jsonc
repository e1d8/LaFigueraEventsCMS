{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "la-figuera-events-cms",
  "main": "index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://e1d8.github.io"
  },
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "183701", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "183702", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
